# Server settings
PORT=5000
NODE_ENV=production

# Database settings
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=exam_system
DB_SSL=false # Set to true if deploying to TiDB Cloud or secure MySQL host

# Authentication settings
JWT_SECRET=your_jwt_secret_key_here

# AI Service settings (OpenRouter)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# SMTP Email settings
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password_here
